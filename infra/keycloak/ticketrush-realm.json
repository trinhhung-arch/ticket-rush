{
  "realm": "ticketrush",
  "displayName": "TicketRush",
  "enabled": true,
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 900,
  "roles": {
    "realm": [
      {
        "name": "CUSTOMER",
        "description": "Buys tickets; every new account gets it"
      },
      {
        "name": "ORGANIZER",
        "description": "Creates and publishes events, checks tickets in"
      },
      {
        "name": "ADMIN",
        "description": "Operates the platform"
      },
      {
        "name": "offline_access",
        "description": "${role_offline-access}"
      },
      {
        "name": "uma_authorization",
        "description": "${role_uma_authorization}"
      },
      {
        "name": "default-roles-ticketrush",
        "description": "Given to every account, including self-registered ones",
        "composite": true,
        "composites": {
          "realm": [
            "offline_access",
            "uma_authorization",
            "CUSTOMER"
          ],
          "client": {
            "account": [
              "view-profile",
              "manage-account"
            ]
          }
        }
      }
    ]
  },
  "defaultRole": {
    "name": "default-roles-ticketrush",
    "composite": true
  },
  "clients": [
    {
      "clientId": "ticketrush-web",
      "name": "TicketRush web and Swagger UI",
      "description": "Browser login (authorization code with PKCE) for the gateway's Swagger UI: compose on 8080 or 18080, kind on 28080",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "redirectUris": [
        "http://localhost:8080/*",
        "http://localhost:18080/*",
        "http://localhost:28080/*"
      ],
      "webOrigins": [
        "http://localhost:8080",
        "http://localhost:18080",
        "http://localhost:28080"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "protocolMappers": [
        {
          "name": "ticketrush-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "ticketrush-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "realm roles as roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles",
            "multivalued": "true",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "ticketrush-cli",
      "name": "TicketRush scripts",
      "description": "Local development only: password grant for curl, the smoke test and the demo",
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "protocolMappers": [
        {
          "name": "ticketrush-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "ticketrush-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "realm roles as roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles",
            "multivalued": "true",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "organizer@ticketrush.dev",
