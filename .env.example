# Copy to .env to override the development defaults used by docker-compose.yml.
# Real deployments inject these from a secret store (NFR-SEC-03); never commit a filled-in .env.
POSTGRES_PASSWORD=postgres_dev
EVENT_DB_PASSWORD=event_dev
BOOKING_DB_PASSWORD=booking_dev
PAYMENT_DB_PASSWORD=payment_dev
TICKET_DB_PASSWORD=ticket_dev
NOTIFY_DB_PASSWORD=notify_dev

# Host port of the API gateway; change it if 8080 is taken on your machine.
GATEWAY_PORT=8080
