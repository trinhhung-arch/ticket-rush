# Variables docker-compose.yml needs. Generate real values with ./scripts/init-dev-env.sh,
# which writes a git-ignored .env; deployments inject them from a secret store (NFR-SEC-03).
POSTGRES_PASSWORD=
EVENT_DB_PASSWORD=
BOOKING_DB_PASSWORD=
PAYMENT_DB_PASSWORD=
TICKET_DB_PASSWORD=
NOTIFY_DB_PASSWORD=
# HMAC key for ticket QR codes, at least 32 characters.
TICKET_SIGNING_KEY=
# HS256 key for waiting-room admission tokens, shared by waiting-room-service and booking-service.
ADMISSION_TOKEN_KEY=
# Host port of the API gateway; change it if 8080 is taken on your machine.
GATEWAY_PORT=8080
